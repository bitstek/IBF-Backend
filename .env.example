# ──────────────────────────────────────────────
# IBF Backend — Environment Variables Template
# ──────────────────────────────────────────────

# Server Port
PORT=4000

# SMTP Credentials
SMTP_HOST=smtp.zoho.in
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=alerts@ibf.com.sa
SMTP_PASS=your-app-password

# Target Recipient Email
RECIPIENT_EMAIL=ms@ibf.com.sa

# Allowed Frontend URL (for CORS)
FRONTEND_URL=http://127.0.0.1:5173
